# ============================================================
# xbot — contoh konfigurasi environment.
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# ============================================================

# Generate a random master key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
# Required only until the first administrator is created. Remove afterward.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.invalid

# --- Database & dashboard ---
DATABASE_PATH=data/dca_bot.db
DB_PATH=data/dca_bot.db
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
PORT=5000
# Default Compose exposure is localhost-only. Set 0.0.0.0 only behind an
# operator-managed firewall and HTTPS reverse proxy.
XBOT_BIND_ADDRESS=127.0.0.1
XBOT_HOST_PORT=5000
DASHBOARD_DEBUG=false
LOG_LEVEL=INFO
# File Python dikosongkan otomatis saat mencapai batas ini (1 MiB).
PYTHON_LOG_MAX_BYTES=1048576

# --- Live trading gate (real trade) ---
# Real trade hanya berjalan jika SEMUA syarat berikut terpenuhi:
#   1. LIVE_TRADING_ENABLED=true
#   2. MAX_ACCOUNT_EXPOSURE_IDR > 0 dan >= total modal siklus strategi
#      (base order + seluruh safety order)
#   3. Batas posisi strategi (max_position_amount) >= modal siklus
#   4. Jumlah siklus dry-run yang selesai >= LIVE_MIN_DRY_RUN_CYCLES
#      (isi 0 untuk menonaktifkan syarat bukti dry-run ini)
# Catatan: bot tidak pernah memakai izin withdrawal; gunakan API key
# khusus trading dengan whitelist IP.
# 0 mematikan cap exposure sekaligus MEMBLOKIR seluruh real trade.
MAX_ACCOUNT_EXPOSURE_IDR=0
LIVE_TRADING_ENABLED=false
# Minimal siklus dry-run selesai sebelum bot boleh real trade (rentang 0-100).
# 0 menonaktifkan syarat bukti dry-run; nilai di luar rentang kembali ke 1.
LIVE_MIN_DRY_RUN_CYCLES=1
# Usang — tidak lagi diberlakukan gate; tetap dibaca hanya agar
# .env lama tetap kompatibel. Boleh dikosongkan.
LIVE_TRADING_CONFIRMATION=
LIVE_TRADING_BOT_IDS=

# --- Ketahanan API ---
API_CIRCUIT_FAILURE_THRESHOLD=5
API_CIRCUIT_COOLDOWN_SECONDS=120

# --- Telegram ---
TELEGRAM_PRICE_CHANGE_PERCENT=5
TELEGRAM_DIGEST_HOUR=8
TELEGRAM_TIMEZONE=Asia/Jakarta
TELEGRAM_POLL_MS=5000
TELEGRAM_FEED_SCAN_MS=15000
# Batasi burst; default satu pesan per interval polling.
TELEGRAM_MAX_MESSAGES_PER_RUN=1
# Opsional: timeout kirim (ms) dan endpoint API (ubah hanya untuk pengujian).
TELEGRAM_SEND_TIMEOUT_MS=10000
TELEGRAM_API_BASE=https://api.telegram.org

# --- Backup & runtime ---
# Optional: use a distinct secret for encrypted database backups.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
BACKUP_RETENTION=14
# Dipakai Node & Python untuk sinyal heartbeat bot manager
# (di Compose, /tmp adalah tmpfs sehingga default ini aman).
MANAGER_HEARTBEAT_PATH=/tmp/xbot-manager-heartbeat
# Batas rotasi log container Compose.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
