# Generate a random master key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
# Required only until the first administrator is created. Remove afterward.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.invalid
DATABASE_PATH=data/dca_bot.db
DB_PATH=data/dca_bot.db
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
PORT=5000
# Default Compose exposure is localhost-only. Set 0.0.0.0 only behind an
# operator-managed firewall and HTTPS reverse proxy.
XBOT_BIND_ADDRESS=127.0.0.1
XBOT_HOST_PORT=5000
DASHBOARD_DEBUG=false
LOG_LEVEL=INFO
# File Python dikosongkan otomatis saat mencapai batas ini (1 MiB).
PYTHON_LOG_MAX_BYTES=1048576
# Safety controls. A zero exposure limit disables the account-wide cap.
MAX_ACCOUNT_EXPOSURE_IDR=0
# Live gate: LIVE_TRADING_ENABLED=true membuka real trade.
LIVE_TRADING_ENABLED=false
# Opsional — tidak lagi diberlakukan oleh gate.
LIVE_TRADING_CONFIRMATION=
LIVE_TRADING_BOT_IDS=
LIVE_MIN_DRY_RUN_CYCLES=1
API_CIRCUIT_FAILURE_THRESHOLD=5
API_CIRCUIT_COOLDOWN_SECONDS=120
# Telegram anti-spam and scheduled summaries (Asia/Jakarta, 08:00 by default).
TELEGRAM_PRICE_CHANGE_PERCENT=5
TELEGRAM_DIGEST_HOUR=8
TELEGRAM_TIMEZONE=Asia/Jakarta
TELEGRAM_POLL_MS=5000
TELEGRAM_FEED_SCAN_MS=15000
# Batasi burst; default satu pesan per interval polling.
TELEGRAM_MAX_MESSAGES_PER_RUN=1
# Optional: use a distinct secret for encrypted database backups.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
BACKUP_RETENTION=14
